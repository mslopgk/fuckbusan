    { "id": "home-archives", "method": "GET", "path": "/api/home/archives", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },

    { "id": "reports-full", "method": "GET", "path": "/api/reports/full", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },
    { "id": "reports-clusters", "method": "GET", "path": "/api/reports/clusters", "expectStatus": [200], "expectBody": { "isArray": true } },
    { "id": "reports-list", "method": "GET", "path": "/api/reports/list", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },
    { "id": "proposals-list", "method": "GET", "path": "/api/reports/proposals", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },

    { "id": "surveys-list", "method": "GET", "path": "/api/surveys/list", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },
    { "id": "surveys-list-active", "method": "GET", "path": "/api/surveys/list?tab=active", "expectStatus": [200], "expectBody": { "isArray": true } },
    { "id": "surveys-list-result", "method": "GET", "path": "/api/surveys/list?tab=result", "expectStatus": [200], "expectBody": { "isArray": true } },
    { "id": "survey-detail", "method": "GET", "path": "/api/surveys/1", "expectStatus": [200, 404] },

    { "id": "checklist-list", "method": "GET", "path": "/checklist/list", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },
    { "id": "checklist-clusters", "method": "GET", "path": "/checklist/clusters", "expectStatus": [200], "expectBody": { "isArray": true } },
    { "id": "checklist-aggregate", "method": "GET", "path": "/checklist/aggregate", "expectStatus": [200], "expectBody": { "isArray": true } },

    { "id": "admin-stats", "method": "GET", "path": "/api/admin/stats", "expectStatus": [401, 403] },
    { "id": "admin-recent", "method": "GET", "path": "/api/admin/recent-activity", "expectStatus": [401, 403] },
    { "id": "admin-trends", "method": "GET", "path": "/api/admin/trends?metric=reports&period=month", "expectStatus": [401, 403] },
    { "id": "admin-category-distribution", "method": "GET", "path": "/api/admin/category-distribution?target=reports", "expectStatus": [401, 403] },
    { "id": "admin-leaderboard", "method": "GET", "path": "/api/admin/district-leaderboard", "expectStatus": [401, 403] },
    { "id": "admin-users", "method": "GET", "path": "/api/admin/users", "expectStatus": [401, 403] },
    { "id": "admin-proposals", "method": "GET", "path": "/api/admin/proposals", "expectStatus": [401, 403] },
    { "id": "admin-activity-logs", "method": "GET", "path": "/api/admin/activity-logs", "expectStatus": [401, 403] },

    { "id": "notifications-list", "method": "GET", "path": "/api/notifications", "expectStatus": [401, 403] },
    { "id": "notifications-unread", "method": "GET", "path": "/api/notifications/unread-count", "expectStatus": [401, 403] },

    { "id": "search-empty", "method": "GET", "path": "/api/search?q=", "expectStatus": [200], "expectBody": { "isArray": true } },
    { "id": "search-keyword", "method": "GET", "path": "/api/search?q=%EB%B6%80%EC%82%B0", "expectStatus": [200], "expectBody": { "isArray": true } },
    { "id": "search-suggest", "method": "GET", "path": "/api/search/suggest?q=%EA%B0%9C%EC%84%A0", "expectStatus": [200], "expectBody": { "isArray": true } },

