    { "id": "home-citizens", "method": "GET", "path": "/api/home/citizens", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },
    { "id": "home-archives", "method": "GET", "path": "/api/home/archives", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },

    { "id": "reports-full", "method": "GET", "path": "/api/reports/full", "expectStatus": [200], "expectBody": { "isArray": true, "minItems": 1 } },
